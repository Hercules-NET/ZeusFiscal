namespace FastReport
{
  public class ReportScript
  {
    private void Emitente_BeforePrint(object sender, EventArgs e)
    {
      var chave = Substring(((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.Id&quot;)), 3);
      TextChaveAcesso.Text = Regex.Replace(chave, &quot;.{4}&quot;, &quot;$0 &quot;);
      BarcodeChave.Text = chave;
      poEmitLogo.Image = ObterLogo();
      PreencherRegimeTributario();
      PreencherTotaisIBSCBSIS();
      PreencherTotaisICMS();
      PreencherFaturaDuplicatas();
      PreencherTransportador();

      var contigenciaId = (string)Report.GetParameterValue(&quot;ContingenciaID&quot;);
      BarCodeContigencia.Visible = !string.IsNullOrEmpty(contigenciaId);
      if(BarCodeContigencia.Visible) BarCodeContigencia.Text = contigenciaId;
      DadosISSQN.Visible = !(bool)Report.GetParameterValue(&quot;ImprimirISSQN&quot;);
      DadosRetencoes.Visible = (bool)Report.GetParameterValue(&quot;ExibeRetencoes&quot;);
      // Leiaute NT 2026.010: as celulas de tributos possuem varias linhas, a linha do item sempre se ajusta
      prodRow.AutoSize = true;
      prodNomeCell.WordWrap = (bool)Report.GetParameterValue(&quot;DuasLinhas&quot;);

      if (Report.GetColumnValue(&quot;NFe.NFe.infNFe.emit.enderEmit.fone&quot;) != null) {
        Text209.Text = FormatarCampo(Report.GetColumnValue(&quot;NFe.NFe.infNFe.emit.enderEmit.fone&quot;).ToString(), 'f');
      }

      if ((FinalidadeNFe)(Report.GetColumnValue(&quot;NFe.NFe.infNFe.ide.finNFe&quot;)) == FinalidadeNFe.fnDevolucao)
      {
        var ipi = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ICMSTot.vIPI&quot;)) ?? 0M;
        if (ipi &lt;= 0)
        {
          var ipiDevolvido = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ICMSTot.vIPIDevol&quot;)) ?? 0M;
          Text163.Text = FormatNumber(ipiDevolvido,2);
        }
      }

      //Trato o campo de Frete
      switch((int)((ModalidadeFrete)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.modFrete&quot;)))
      {
        case 0: Memo92.Text = &quot;0 - Emit/Remet&quot;; break;
        case 1: Memo92.Text = &quot;1 - Destinatário&quot;; break;
        case 2: Memo92.Text = &quot;2 - Terceiros&quot;; break;
        case 3: Memo92.Text = &quot;3 - Prop Remetente&quot;; break;
        case 4: Memo92.Text = &quot;4 - Prop Destinatário&quot;; break;
        case 9: Memo92.Text = &quot;9 - Sem Frete&quot;; break;
      }

      var vol = Report.GetDataSource(&quot;NFe.NFe.infNFe.transp.vol&quot;);
	  if(vol != null){
        vol.Init();
        int qtdeVol = 0;
	    
        int volumes = 0;
        decimal pesoL = 0;
        decimal pesoB = 0;
        while (vol.HasMoreRows)
        {
          Memo106.Text = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.esp&quot;));
          Memo108.Text = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.marca&quot;));
          Memo110.Text = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.nVol&quot;));
	    
          volumes += ((Nullable&lt;int&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.qVol&quot;)) ?? 0;
          pesoL += ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.pesoL&quot;)) ?? 0M;
          pesoB += ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.pesoB&quot;)) ?? 0M;
          qtdeVol++;
          vol.Next();
        }
	    
        if (qtdeVol &gt;= 1)
        {
          if (qtdeVol &gt; 1)
          {
            Memo106.Text = &quot;VOLUMES&quot;;
            Memo108.Text = &quot;&quot;;
            Memo110.Text = &quot;&quot;;
          }
	    
          Memo104.Text = volumes.ToString();
          Memo112.Text = FormatNumber(pesoB,3) + &quot; KG&quot;;
          Memo114.Text = FormatNumber(pesoL,3) + &quot; KG&quot;;
        }
	  }

      if(Engine.FinalPass)
      {
        var vBC = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ISSQNtot.vBC&quot;)) ?? 0;
        var vISS = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ISSQNtot.vISS&quot;)) ?? 0;
        var vServ = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ISSQNtot.vServ&quot;)) ?? 0;

        DadosISSQN.Visible = !(vBC == 0 &amp;&amp; vISS == 0 &amp;&amp; vServ == 0);

        var retiradaCPF = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.CPF&quot;);
        var retiradaCNPJ = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.CNPJ&quot;);
        var retiradaEndereco = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.xLgr&quot;);
        var retiradaNro = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.nro&quot;);
        var retiradaBairro = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.xBairro&quot;);
        var retiradaMunicipio = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.xMun&quot;);
        var retiradaUf = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.UF&quot;);

        LocalRetirada.Visible = !string.IsNullOrEmpty(retiradaCPF) || !string.IsNullOrEmpty(retiradaCNPJ) ||
          !string.IsNullOrEmpty(retiradaEndereco) || !string.IsNullOrEmpty(retiradaNro) ||
          !string.IsNullOrEmpty(retiradaBairro) || !string.IsNullOrEmpty(retiradaMunicipio) ||
          !string.IsNullOrEmpty(retiradaUf);

        var entregaCPF = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.CPF&quot;);
        var entregaCNPJ = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.CNPJ&quot;);
        var entregaEndereco = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.xLgr&quot;);
        var entregaNro = (string)Report.GetColumnValue(&quot;[NFe.NFe.infNFe.entrega.nro]&quot;);
        var entregaBairro = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.xBairro&quot;);
        var entregaMunicipio = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.xMun&quot;);
        var entregaUf = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.UF&quot;);

        LocalEntrega.Visible = !string.IsNullOrEmpty(entregaCPF) || !string.IsNullOrEmpty(entregaCNPJ) ||
          !string.IsNullOrEmpty(entregaEndereco) || !string.IsNullOrEmpty(entregaNro) ||
          !string.IsNullOrEmpty(entregaBairro) || !string.IsNullOrEmpty(entregaMunicipio) ||
          !string.IsNullOrEmpty(entregaUf);


      }

      string infAdicionais = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.infAdic.infCpl&quot;) + Environment.NewLine + (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.infAdic.infAdFisco&quot;);

      infAdicionais = infAdicionais.Replace(&quot;[&quot;,&quot;[\&quot;[&quot;).Replace(&quot;]&quot;,&quot;]\&quot;]&quot;);

      if((bool)Report.GetParameterValue(&quot;QuebrarLinhasObservacao&quot;))
      {
        infAdicionais = infAdicionais.Replace(&quot;;&quot;, Environment.NewLine);
      }

      TextInfAdicionais.Text = infAdicionais;
      //memContInfAdicionais.Text = string.Empty;

      //string[] lines = infAdicionais.Split(new string[]{ Environment.NewLine, &quot;\n&quot; }, StringSplitOptions.None);
      //pgContDadosAdicionais.Visible = lines.Length &gt; LINHAS_DADOS_ADICIONAIS;

      //if(pgContDadosAdicionais.Visible)
      //{
      //  TextInfAdicionais.Text = string.Join(Environment.NewLine, lines.Take(LINHAS_DADOS_ADICIONAIS-1).ToArray());
      //  memContInfAdicionais.Text = string.Join(Environment.NewLine, lines.Skip(LINHAS_DADOS_ADICIONAIS-1).ToArray());
      //}
      }

    private void _StartReport(object sender, EventArgs e)
    {
      // Canhoto facultativo (NT 2026.010 - item 4.4)
      var exibirCanhoto = Report.GetParameterValue(&quot;ExibirCanhoto&quot;);
      Canhoto.Visible = exibirCanhoto == null || (bool)exibirCanhoto;

      // QR Code (NT 2026.010 - itens 4.4 e 4.5): exibido somente quando informado no XML
      string qrCode = null;
      try { qrCode = Convert.ToString(Report.GetColumnValue(&quot;NFe.NFe.infNFeSupl.qrCode&quot;)); } catch { }
      var exibirQrCode = !string.IsNullOrEmpty(qrCode);
      MemoQrCodeBox.Visible = exibirQrCode;
      MemoQrCodeTitulo.Visible = exibirQrCode;
      bcoQrCode.Visible = exibirQrCode;
      if (exibirQrCode)
      {
        bcoQrCode.Text = qrCode;
        DadosAdicionais.Height = 107.73f;
        Text155.Width = 400f;
        TextInfAdicionais.Width = 397f;
        Text156.Left = 400f;
        Text156.Width = 188.9f;
        Text37.Left = 402f;
        Text37.Width = 184.9f;
      }
    }

    private void DadosProdutos_BeforePrint(object sender, EventArgs e)
    {
      var icmsBasico = (ICMSBasico)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.imposto.ICMS.TipoICMS&quot;);
      var ipiBasico = (IPIBasico)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.imposto.IPI.TipoIPI&quot;);
      var ibsCbs = ObterIBSCBSItem();
      var impostoSeletivo = Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.imposto.IS&quot;) as global::NFe.Classes.Informacoes.Detalhe.Tributacao.IS;
      var crt = (CRT)Report.GetColumnValue(&quot;NFe.NFe.infNFe.emit.CRT&quot;);
      var simplesNacional = crt == CRT.SimplesNacional || crt == CRT.SimplesNacionalMei;

      // CST / CFOP
      var cst = string.Empty;
      var rotuloCst = &quot;CST&quot;;
      string icmsBc = &quot;&quot;, icmsAliq = &quot;&quot;, icmsValor = &quot;&quot;;
      if (icmsBasico != null)
      {
        var orig = icmsBasico.GetIcmsOrig();
        var cstIcms = icmsBasico.GetIcmsCst().CsticmsParaString();
        if (simplesNacional &amp;&amp; cstIcms != &quot;02&quot; &amp;&amp; cstIcms != &quot;15&quot; &amp;&amp; cstIcms != &quot;53&quot; &amp;&amp; cstIcms != &quot;61&quot;)
        {
          rotuloCst = &quot;CSOSN&quot;;
          cst = orig.OrigemMercadoriaParaString() + icmsBasico.GetIcmsCsosn().CsosnicmsParaString();
        }
        else
        {
          cst = orig.OrigemMercadoriaParaString() + cstIcms;
        }
        icmsBc = FormatarValorRTC(icmsBasico.GetIcmsBcValue());
        icmsAliq = FormatarAliquotaRTC(icmsBasico.GetIcmsPercent());
        icmsValor = FormatarValorRTC(icmsBasico.GetIcmsValue());
      }
      var cfop = Convert.ToString(Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.CFOP&quot;));
      prodOriginCell.Text = rotuloCst + &quot; &quot; + cst + Environment.NewLine + &quot;CFOP &quot; + cfop;

      // IPI
      string ipiBc = &quot;&quot;, ipiAliq = &quot;&quot;, ipiValor = &quot;&quot;;
      var ipiTrib = ipiBasico as global::NFe.Classes.Informacoes.Detalhe.Tributacao.Federal.IPITrib;
      if (ipiTrib != null)
      {
        if (ipiTrib.vBC.HasValue) ipiBc = FormatarValorRTC(ipiTrib.vBC.Value);
        if (ipiTrib.pIPI.HasValue) ipiAliq = FormatarAliquotaRTC(ipiTrib.pIPI.Value);
        ipiValor = FormatarValorRTC(ipiTrib.vIPI ?? 0M);
      }
      else if (ipiBasico == null &amp;&amp; (FinalidadeNFe)(Report.GetColumnValue(&quot;NFe.NFe.infNFe.ide.finNFe&quot;)) == FinalidadeNFe.fnDevolucao)
      {
        var devolvidoPercentual = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.impostoDevol.pDevol&quot;)) ?? 0M;
        var ipiDevolvidoValor = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.impostoDevol.IPI.vIPIDevol&quot;)) ?? 0M;
        if (ipiDevolvidoValor &gt; 0)
        {
          ipiValor = FormatarValorRTC(ipiDevolvidoValor);
          ipiAliq = FormatarAliquotaRTC(devolvidoPercentual);
        }
      }

      // IBS / CBS (Grupo UB) - com gRed informado imprime a aliquota efetiva (pAliqEfet)
      string ibsCbsBc = &quot;&quot;, ibsUfAliq = &quot;&quot;, ibsUfValor = &quot;&quot;, ibsMunAliq = &quot;&quot;, ibsMunValor = &quot;&quot;, cbsAliq = &quot;&quot;, cbsValor = &quot;&quot;;
      var gIBSCBS = ibsCbs != null ? ibsCbs.gIBSCBS : null;
      if (gIBSCBS != null)
      {
        ibsCbsBc = FormatarValorRTC(gIBSCBS.vBC);
        if (gIBSCBS.gIBSUF != null)
        {
          ibsUfAliq = FormatarAliquotaRTC(gIBSCBS.gIBSUF.gRed != null ? gIBSCBS.gIBSUF.gRed.pAliqEfet : gIBSCBS.gIBSUF.pIBSUF);
          ibsUfValor = FormatarValorRTC(gIBSCBS.gIBSUF.vIBSUF);
        }
        if (gIBSCBS.gIBSMun != null)
        {
          ibsMunAliq = FormatarAliquotaRTC(gIBSCBS.gIBSMun.gRed != null ? gIBSCBS.gIBSMun.gRed.pAliqEfet : gIBSCBS.gIBSMun.pIBSMun);
          ibsMunValor = FormatarValorRTC(gIBSCBS.gIBSMun.vIBSMun);
        }
        if (gIBSCBS.gCBS != null)
        {
          cbsAliq = FormatarAliquotaRTC(gIBSCBS.gCBS.gRed != null ? gIBSCBS.gCBS.gRed.pAliqEfet : gIBSCBS.gCBS.pCBS);
          cbsValor = FormatarValorRTC(gIBSCBS.gCBS.vCBS);
        }
      }

      // Imposto Seletivo
      string isBc = &quot;&quot;, isAliq = &quot;&quot;, isValor = &quot;&quot;;
      if (impostoSeletivo != null)
      {
        isBc = FormatarValorRTC(impostoSeletivo.vBCIS);
        isAliq = FormatarAliquotaRTC(impostoSeletivo.pIS);
        isValor = FormatarValorRTC(impostoSeletivo.vIS);
      }

      var nl = Environment.NewLine;
      prodBcLCell.Text = &quot;ICMS&quot; + nl + &quot;IBS / CBS&quot; + nl + &quot;IS&quot; + nl + &quot;IPI&quot;;
      prodBcVCell.Text = icmsBc + nl + ibsCbsBc + nl + isBc + nl + ipiBc;
      prodAlqLACell.Text = &quot;ICMS&quot; + nl + &quot;IBS UF&quot; + nl + &quot;IBS MUN&quot;;
      prodAlqVACell.Text = icmsAliq + nl + ibsUfAliq + nl + ibsMunAliq;
      prodAlqLBCell.Text = &quot;/ CBS&quot; + nl + &quot;/ IPI&quot; + nl + &quot;/ IS&quot;;
      prodAlqVBCell.Text = cbsAliq + nl + ipiAliq + nl + isAliq;
      prodVlrLACell.Text = prodAlqLACell.Text;
      prodVlrVACell.Text = icmsValor + nl + ibsUfValor + nl + ibsMunValor;
      prodVlrLBCell.Text = prodAlqLBCell.Text;
      prodVlrVBCell.Text = cbsValor + nl + ipiValor + nl + isValor;

      // Quantidade / unidade / valores
      var imprimirUnidQtdeValor = (ImprimirUnidQtdeValor)Report.GetParameterValue(&quot;ImprimirUnidQtdeValor&quot;);
      var imprimirTotalLiquido = (bool)Report.GetParameterValue(&quot;ImprimirTotalLiquido&quot;);
      var uCom = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.uCom&quot;));
      var uTrib = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.uTrib&quot;));
      var qCom = ((Decimal)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.qCom&quot;));
      var qTrib = ((Decimal)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.qTrib&quot;));
      var vUnCom = ((Decimal)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.vUnCom&quot;));
      var vUnTrib = ((Decimal)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.vUnTrib&quot;));
      var vProd = ((Decimal)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.vProd&quot;));
      var vDesc = (((Nullable&lt;Decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.vDesc&quot;)) ?? 0);
      if (imprimirTotalLiquido) vProd = vProd - vDesc;
      prodValorCell.Text = FormatNumber(vProd, 2);
      var decimaisQuantidadeItem = (int)Report.GetParameterValue(&quot;DecimaisQuantidadeItem&quot;);
      var decimaisValorUnitario = (int)Report.GetParameterValue(&quot;DecimaisValorUnitario&quot;);
      switch (imprimirUnidQtdeValor)
      {
        case ImprimirUnidQtdeValor.Comercial:
          prodQtdCell.Text = FormatNumber(qCom, decimaisQuantidadeItem) + nl + &quot;[&quot; + uCom + &quot;]&quot;;
          prodValorUnitarioCell.Text = FormatNumber(vUnCom, decimaisValorUnitario);
          break;
        case ImprimirUnidQtdeValor.Tributavel:
          prodQtdCell.Text = FormatNumber(qTrib, decimaisQuantidadeItem) + nl + &quot;[&quot; + uTrib + &quot;]&quot;;
          prodValorUnitarioCell.Text = FormatNumber(vUnTrib, decimaisValorUnitario);
          break;
        case ImprimirUnidQtdeValor.Ambos:
          prodQtdCell.Text = FormatNumber(qCom, decimaisQuantidadeItem) + nl + &quot;[&quot; + uCom + &quot;]&quot; + nl +
            FormatNumber(qTrib, decimaisQuantidadeItem) + nl + &quot;[&quot; + uTrib + &quot;]&quot;;
          prodValorUnitarioCell.Text = FormatNumber(vUnCom, decimaisValorUnitario) + nl + nl + FormatNumber(vUnTrib, decimaisValorUnitario);
          break;
      }
    }

    private static readonly CultureInfo CulturaRTC = new CultureInfo(&quot;pt-BR&quot;);

    private string FormatarValorRTC(decimal valor)
    {
      return valor.ToString(&quot;#,##0.00&quot;, CulturaRTC);
    }

    private string FormatarValorOpcional(Nullable&lt;decimal&gt; valor)
    {
      return valor.HasValue ? FormatarValorRTC(valor.Value) : string.Empty;
    }

    private string FormatarQuantidadeOpcional(Nullable&lt;decimal&gt; valor)
    {
      return valor.HasValue ? valor.Value.ToString(&quot;#,##0.00##&quot;, CulturaRTC) : string.Empty;
    }

    private string FormatarAliquotaRTC(decimal valor)
    {
      return valor.ToString(&quot;#,##0.00##&quot;, CulturaRTC) + &quot;%&quot;;
    }

    private static bool Positivo(Nullable&lt;decimal&gt; valor)
    {
      return valor.HasValue &amp;&amp; valor.Value != 0;
    }

    private static string EscaparHtml(string texto)
    {
      if (string.IsNullOrEmpty(texto)) return string.Empty;
      return texto.Replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;).Replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;).Replace(&quot;&gt;&quot;, &quot;&amp;gt;&quot;);
    }

    private global::NFe.Classes.Informacoes.Detalhe.Tributacao.IBSCBS ObterIBSCBSItem()
    {
      return Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.imposto.IBSCBS&quot;) as global::NFe.Classes.Informacoes.Detalhe.Tributacao.IBSCBS;
    }

    // Descricao do item: codigo (negrito) + descricao, informacoes adicionais e [NCM] [cClassTrib] (NT 2026.010 - item 4.3)
    public string TextoDescricaoItem()
    {
      var nl = Environment.NewLine;
      var texto = &quot;&lt;b&gt;&quot; + EscaparHtml(Convert.ToString(Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.cProd&quot;))) + &quot;&lt;/b&gt; &quot; +
        EscaparHtml(Convert.ToString(Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.xProd&quot;)));
      var infAdProd = Convert.ToString(Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.infAdProd&quot;));
      if (!string.IsNullOrEmpty(infAdProd)) texto += nl + EscaparHtml(infAdProd);

      var partes = new List&lt;string&gt;();
      var ncm = Convert.ToString(Report.GetColumnValue(&quot;NFe.NFe.infNFe.det.prod.NCM&quot;));
      if (!string.IsNullOrEmpty(ncm)) partes.Add(&quot;[NCM &quot; + EscaparHtml(ncm) + &quot;]&quot;);
      var ibsCbs = ObterIBSCBSItem();
      if (ibsCbs != null &amp;&amp; !string.IsNullOrEmpty(ibsCbs.cClassTrib)) partes.Add(&quot;[cClassTrib &quot; + EscaparHtml(ibsCbs.cClassTrib) + &quot;]&quot;);
      if (partes.Count &gt; 0) texto += nl + string.Join(&quot; &quot;, partes.ToArray());
      return texto;
    }

    private void PreencherRegimeTributario()
    {
      TextCRT.Text = string.Empty;
      var crt = Report.GetColumnValue(&quot;NFe.NFe.infNFe.emit.CRT&quot;);
      if (crt == null) return;
      switch ((int)(CRT)crt)
      {
        case 1: TextCRT.Text = &quot;1 - SIMPLES NACIONAL&quot;; break;
        case 2: TextCRT.Text = &quot;2 - SIMPLES NACIONAL - EXCESSO DE SUBLIMITE&quot;; break;
        case 3: TextCRT.Text = &quot;3 - REGIME NORMAL&quot;; break;
        case 4: TextCRT.Text = &quot;4 - SIMPLES NACIONAL - MEI&quot;; break;
      }
      // Tipo de Regime de Apuracao do IBS e da CBS: campo reservado (NT 2026.010 - item 4.4), sem conteudo
      TextTpRegApurIBSCBS.Text = string.Empty;
    }

    // Linhas facultativas do bloco &quot;TOTAL DO ICMS / IPI&quot; (NT 2026.010 - item 4.4)
    private void PreencherTotaisICMS()
    {
      var icmsTot = Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ICMSTot&quot;) as ICMSTot;
      TotalICMSFCP.Visible = icmsTot != null &amp;&amp;
        (Positivo(icmsTot.vFCP) || Positivo(icmsTot.vFCPST) || Positivo(icmsTot.vICMSUFDest) || Positivo(icmsTot.vFCPUFDest));
      TotalICMSMono.Visible = icmsTot != null &amp;&amp;
        (Positivo(icmsTot.qBCMono) || Positivo(icmsTot.vICMSMono) || Positivo(icmsTot.qBCMonoReten) || Positivo(icmsTot.vICMSMonoReten));
      if (icmsTot == null) return;

      TextTotVFCP.Text = FormatarValorOpcional(icmsTot.vFCP);
      TextTotVFCPST.Text = FormatarValorOpcional(icmsTot.vFCPST);
      TextTotVICMSUFDest.Text = FormatarValorOpcional(icmsTot.vICMSUFDest);
      TextTotVFCPUFDest.Text = FormatarValorOpcional(icmsTot.vFCPUFDest);

      TextTotQBCMono.Text = FormatarQuantidadeOpcional(icmsTot.qBCMono);
      TextTotVICMSMono.Text = FormatarValorOpcional(icmsTot.vICMSMono);
      TextTotQBCMonoReten.Text = FormatarQuantidadeOpcional(icmsTot.qBCMonoReten);
      TextTotVICMSMonoReten.Text = FormatarValorOpcional(icmsTot.vICMSMonoReten);

      var exibirIbpt = Report.GetParameterValue(&quot;ExibirTotalTributos&quot;);
      QuadroVTOTTRIB.Visible = exibirIbpt != null &amp;&amp; (bool)exibirIbpt;
      txtIbptValor.Visible = QuadroVTOTTRIB.Visible;
    }

    // Bloco &quot;TOTAL DO IBS / CBS / IS&quot; (NT 2026.010 - item 4.1)
    private void PreencherTotaisIBSCBSIS()
    {
      var ibsCbsTot = Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.IBSCBSTot&quot;) as IBSCBSTot;
      var isTot = Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ISTot&quot;) as ISTot;

      TotalIBSCBSIS.Visible = ibsCbsTot != null || isTot != null;
      TotalIBSCBSMono.Visible = ibsCbsTot != null &amp;&amp; ibsCbsTot.gMono != null;
      if (!TotalIBSCBSIS.Visible) return;

      decimal vCBS = 0, vIBSUF = 0, vIBSMun = 0, vIS = 0;
      if (ibsCbsTot != null)
      {
        if (ibsCbsTot.gCBS != null) vCBS = ibsCbsTot.gCBS.vCBS;
        if (ibsCbsTot.gIBS != null)
        {
          if (ibsCbsTot.gIBS.gIBSUF != null) vIBSUF = ibsCbsTot.gIBS.gIBSUF.vIBSUF;
          if (ibsCbsTot.gIBS.gIBSMun != null) vIBSMun = ibsCbsTot.gIBS.gIBSMun.vIBSMun;
        }
      }
      if (isTot != null) vIS = isTot.vIS;

      TextTotVCBS.Text = FormatarValorRTC(vCBS);
      TextTotVIBSUF.Text = FormatarValorRTC(vIBSUF);
      TextTotVIBSMun.Text = FormatarValorRTC(vIBSMun);
      TextTotVIS.Text = isTot != null ? FormatarValorRTC(vIS) : string.Empty;

      if (TotalIBSCBSMono.Visible)
      {
        var mono = ibsCbsTot.gMono;
        TextTotVIBSMono.Text = FormatarValorRTC(mono.vIBSMono);
        TextTotVCBSMono.Text = FormatarValorRTC(mono.vCBSMono);
        TextTotVIBSMonoReten.Text = FormatarValorRTC(mono.vIBSMonoReten);
        TextTotVCBSMonoReten.Text = FormatarValorRTC(mono.vCBSMonoReten);
      }
    }

    // Quadro &quot;FATURA / DUPLICATAS&quot; (NT 2026.010 - modelo vertical): grade com 3 duplicatas por linha
    // (FATURA/DUPLICATA | VENCIMENTO | VALOR). Facultativo - suprimido quando nao houver cobr no XML.
    private float _TamanhoDuplicatas = 0;

    private void PreencherFaturaDuplicatas()
    {
      var cobranca = Report.GetColumnValue(&quot;NFe.NFe.infNFe.cobr&quot;) as global::NFe.Classes.Informacoes.Cobranca.cobr;
      var qtdDuplicatas = 0;
      if (cobranca != null &amp;&amp; cobranca.dup != null) qtdDuplicatas = cobranca.dup.Count;
      FaturaDuplicatas.Visible = qtdDuplicatas &gt; 0;
      Duplicatas.Visible = qtdDuplicatas &gt; 0;
      _TamanhoDuplicatas = Duplicatas.Visible ? (float)Math.Ceiling(qtdDuplicatas / 3.0) * Duplicatas.Height : 0f;
    }

    // Quadro &quot;TRANSPORTADOR / VOLUMES TRANSPORTADOS&quot;: exibido somente quando houver dados de transporte/volumes
    private void PreencherTransportador()
    {
      var transporte = Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp&quot;) as transp;
      TransportadorVolumes.Visible = transporte != null &amp;&amp; (transporte.transporta != null || transporte.veicTransp != null ||
        (transporte.vol != null &amp;&amp; transporte.vol.Count &gt; 0) || (transporte.reboque != null &amp;&amp; transporte.reboque.Count &gt; 0));
    }

    private string FormatarCampo(string valor, char format)
    {
      if (valor == null) return string.Empty;

      switch (format)
      {
        case 'c':  //CEP
          if (valor.Length == 8)
            valor = valor.Substring(0,2) + &quot;.&quot; + valor.Substring(2,3) + &quot;-&quot; + valor.Substring(5,3);
          break;

        case 'f':  //Telefone /celular
          if (valor.Length == 10)
            valor = &quot;(&quot; +valor.Substring(0,2) + &quot;) &quot; + valor.Substring(2,4) + &quot;-&quot; + valor.Substring(6,4);
          else if (valor.Length == 11)
            valor = &quot;(&quot; +valor.Substring(0,2) + &quot;) &quot; + valor.Substring(2,5) + &quot;-&quot; + valor.Substring(7,4);
          break;

        case 'd': //cpf / cnpj
          if (valor.Length == 11)
            valor = valor.Substring(0,3)+&quot;.&quot;+valor.Substring(3,3)+&quot;.&quot;+valor.Substring(6,3)+&quot;-&quot;+valor.Substring(9,2);
          else if (valor.Length == 14)
            valor = valor.Substring(0,2)+&quot;.&quot;+valor.Substring(2,3)+&quot;.&quot;+valor.Substring(5,3)+&quot;/&quot;+valor.Substring(8,4)+&quot;-&quot;+valor.Substring(12,2);
          break;

        case 'p':
          if (valor.Length == 7)
            valor = valor.Substring(0,3)+&quot;-&quot;+valor.Substring(3,4);
          break;
      }
      return valor;
    }

    public Image ObterLogo()
    {
      byte[] logomarca = Report.GetParameterValue(&quot;Logo&quot;) as byte[];

      if (logomarca == null) return null;

      using(var ms = new MemoryStream(logomarca))
      {
        var image = Image.FromStream(ms);
        return image;
      }
    }

    private float _Tamanho = 0;
    private float _TamanhoItens = 0;

    private void DadosProdutosHeader_BeforePrint(object sender, EventArgs e)
    {


      _Tamanho = 0;
      _TamanhoItens = 0;

      if (Canhoto.Visible)
        _Tamanho += Canhoto.Height;

      if (Emitente.Visible)
        _Tamanho += Emitente.Height;

      if (Destinatario.Visible)
        _Tamanho += Destinatario.Height;

      if (LocalRetirada.Visible)
        _Tamanho += LocalRetirada.Height;

      if (LocalEntrega.Visible)
        _Tamanho += LocalEntrega.Height;

      string[] bandasTopo = { &quot;FaturaDuplicatas&quot;, &quot;TotaisNota&quot;, &quot;TotalICMSIPI&quot;, &quot;TotalICMSFCP&quot;, &quot;TotalICMSMono&quot;,
        &quot;TotalIBSCBSIS&quot;, &quot;TotalIBSCBSMono&quot;, &quot;DadosISSQN&quot; };
      foreach (var nomeBanda in bandasTopo)
      {
        var banda = Report.FindObject(nomeBanda) as BandBase;
        if (banda != null &amp;&amp; banda.Visible &amp;&amp; (banda.Parent as BandBase == null || ((BandBase)banda.Parent).Visible))
          _Tamanho += banda.Height;
      }
      _Tamanho += _TamanhoDuplicatas;

      if (TransportadorVolumes.Visible)
        _Tamanho += TransportadorVolumes.Height;

      if (DadosProdutosHeader.Visible)
        _Tamanho += DadosProdutosHeader.Height;

      //_Tamanho += _TamanhoItens;

      if (DadosProdutosFooter.Visible)
        _Tamanho += DadosProdutosFooter.Height;


      if (DadosRetencoes.Visible)
        _Tamanho += DadosRetencoes.Height;

      DadosAdicionais.CalcHeight();

      if (DadosAdicionais.Visible)
        _Tamanho += DadosAdicionais.Height;

      if (Rodape.Visible)
        _Tamanho += Rodape.Height;

    }

    private void DadosProdutos_AfterPrint(object sender, EventArgs e)
    {
      DadosProdutos.StartNewPage = false;

      if (Engine.PageNo == 1)
      {
        _TamanhoItens += DadosProdutos.Height;

        if (_Tamanho + _TamanhoItens &gt;= Engine.PageHeight)
        {
          DadosProdutos.StartNewPage = true;
          _TamanhoItens = 0;
        }
      }
    }



  }
}     </ScriptText>
